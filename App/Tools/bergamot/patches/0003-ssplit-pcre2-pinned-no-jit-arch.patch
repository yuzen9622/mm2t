diff --git a/3rd_party/ssplit-cpp/cmake/FindPCRE2.cmake b/3rd_party/ssplit-cpp/cmake/FindPCRE2.cmake
index 8ea55cb..f731468 100644
--- a/3rd_party/ssplit-cpp/cmake/FindPCRE2.cmake
+++ b/3rd_party/ssplit-cpp/cmake/FindPCRE2.cmake
@@ -33,7 +33,8 @@ if(SSPLIT_USE_INTERNAL_PCRE2)
     # jit compilation isn't supported by wasm
     set(PCRE2_JIT_OPTION  "-DPCRE2_SUPPORT_JIT=OFF")
   else()
-    set(PCRE2_JIT_OPTION  "-DPCRE2_SUPPORT_JIT=ON")
+    # mm2t: no JIT; the app's hardened runtime does not allow writable executable memory.
+    set(PCRE2_JIT_OPTION  "-DPCRE2_SUPPORT_JIT=OFF")
   endif()
 
   # CMAKE_CROSSCOMPILING_EMULATOR might contain semicolon (;) separated arguments. Preventing list
@@ -51,6 +52,9 @@ if(SSPLIT_USE_INTERNAL_PCRE2)
     -DCMAKE_TOOLCHAIN_FILE=${CMAKE_TOOLCHAIN_FILE} # Necessary for proper MacOS compilation
     -DCMAKE_CROSSCOMPILING_EMULATOR=${CMAKE_CROSSCOMPILING_EMULATOR_WITH_SEMICOLON} # Necessary for proper MacOS compilation
     -DCMAKE_POSITION_INDEPENDENT_CODE:BOOL=true # Added for pybind11
+    -DCMAKE_OSX_ARCHITECTURES=${CMAKE_OSX_ARCHITECTURES}
+    -DCMAKE_OSX_DEPLOYMENT_TARGET=${CMAKE_OSX_DEPLOYMENT_TARGET}
+    -DCMAKE_POLICY_VERSION_MINIMUM=3.5
     )
 
   # Android platform needs to be explicitly passed given this is an external project.
@@ -73,6 +77,7 @@ if(SSPLIT_USE_INTERNAL_PCRE2)
   ExternalProject_Add(pcre2
     PREFIX ${CMAKE_BINARY_DIR}/pcre2
     URL ${PCRE2_URL}
+    URL_HASH SHA256=0781bd2536ef5279b1943471fdcdbd9961a2845e1d2c9ad849b9bd98ba1a9bd4
     DOWNLOAD_DIR ${PCRE2_SRC_DIR}
     SOURCE_DIR ${PCRE2_SRC_DIR}
     CONFIGURE_COMMAND ${CMAKE_COMMAND} ${PCRE2_SRC_DIR} ${PCRE2_CONFIGURE_OPTIONS}

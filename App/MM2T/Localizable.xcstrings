    "Google sign-in needs an iOS-type OAuth client ID in this build (client_secret_required).": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個版本的 Google OAuth 用戶端 ID 必須是 iOS 類型（client_secret_required）。"
          }
        }
      }
    },
    "Guessing names": {
      "localizations": {

      "localizations": { "zh-Hant": { "stringUnit": { "state": "translated", "value": "沒有可用的錄音" } } }
    },
    "Couldn't load audio": {
      "localizations": { "zh-Hant": { "stringUnit": { "state": "translated", "value": "無法載入錄音" } } }
    },
    "Keyboard shortcut": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵盤快速鍵"
          }
        }
      }
    },
    "Needs Accessibility permission. Until it is on, the shortcut does nothing.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要「輔助使用」權限，開啟之前快速鍵不會有作用。"
          }
        }
      }
    },
    "Preparing Breeze Core ML…": {
      "localizations": { "zh-Hant": { "stringUnit": { "state": "translated", "value": "正在準備 Breeze Core ML…" } } }
    },
    "Preparing audio…": {
      "localizations": { "zh-Hant": { "stringUnit": { "state": "translated", "value": "正在準備錄音…" } } }
    },
    "Playback position": {
      "localizations": { "zh-Hant": { "stringUnit": { "state": "translated", "value": "播放位置" } } }
    },
    "%@ couldn't read this recording. The file may be damaged or silent.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 無法讀取這段錄音。錄音檔可能已損毀或沒有聲音。"
          }
        }
      }
    },
    "%@ declined to process this meeting under its content safety policy.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 因內容安全政策拒絕處理這場會議。"
          }
        }
      }
    },
    "%@ detected": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測到 %@"
          }
        }
      }
    },
    "%@ failed: %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@失敗：%2$@"
          }
        }
      }
    },
    "%@ had an internal error. Try again later.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 處理時發生內部錯誤。請稍後重試。"
          }
        }
      }
    },
    "%@ is invalid or has expired. Enter it again in Settings and save.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 無效或已過期。請到設定重新填入後儲存。"
          }
        }
      }
    },
    "%@ is temporarily unavailable (busy or under maintenance). Try again later.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 暫時無法服務（忙碌或維護中），請稍後重試。"
          }
        }
      }
    },
    "%@ isn't allowed to use this feature, or the account or project is restricted. Check the key's permissions and the account status in the %@ console.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 沒有這項功能的權限，或帳號／專案受到限制。請到 %2$@ 後台檢查 Key 的權限與帳號狀態。"
          }
        }
      }
    },
    "%@ isn't fully downloaded or couldn't load. Download the model again in Settings.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的模型尚未下載完整或無法載入。請到設定重新下載模型。"
          }
        }
      }
    },
    "%@ meeting": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 會議"
          }
        }
      }
    },
    "%@ rejected this request. Try again; if it keeps failing, please report it.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 拒絕了這次請求的內容。請重試；若一直失敗，請回報這個問題。"
          }
        }
      }
    },
    "%@ reports that a usage or rate limit was reached. Try again later, or check your plan's quota in the %@ console.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 回報已達用量或速率上限。請稍後重試，或到 %2$@ 後台檢查方案額度。"
          }
        }
      }
    },
    "%@ returned a result in an unexpected format. Try again; if it keeps failing, please report it.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 回傳的結果格式不正確。請重試；若一直失敗，請回報這個問題。"
          }
        }
      }
    },
    "%@ signed you out. Connect it again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已登出，請重新連結。"

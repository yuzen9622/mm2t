      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的會議"
          }
        }
      }
    },
    "Your share of the talking": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的發言占比"
          }
        }
      }
    },
    "Your words": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的常用詞"
          }
        }
      }

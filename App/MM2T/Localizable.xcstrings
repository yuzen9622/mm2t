      }
    },
    "Couldn't change speakers": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法修改說話者"
          }
        }
      }
    },
    "Couldn't reach %@.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連上 %@。"
          }
        }
      }
    },
    "Couldn't reach %@. Check that the host is on, on the same local network or Tailscale as this Mac, and that the URL in Settings is correct.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到%@。請確認主機已開機、與這台 Mac 在同一個區網或 Tailscale，以及設定中的網址正確。"
          }
        }
      }
    },
    "Couldn't reach %@. Check your internet connection and try again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到 %@。請確認網路連線後重試。"
          }
        }
      }
    },
    "Couldn't record": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法錄音"
          }
        }
      }
    },
    "Decisions": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "決議"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除"
          }
        }
      }
    },

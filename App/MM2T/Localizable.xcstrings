{
  "sourceLanguage": "en",
  "strings": {
    "%@ couldn't read this recording. The file may be damaged or silent.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 無法讀取這段錄音。錄音檔可能已損毀或沒有聲音。"
          }
        }
      }
    },
    "%@ declined to process this meeting under its content safety policy.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 因內容安全政策拒絕處理這場會議。"
          }
        }
      }
    },
    "%@ detected": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測到 %@"
          }
        }
      }
    },
    "%@ failed: %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@失敗：%2$@"
          }
        }
      }
    },
    "%@ had an internal error. Try again later.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 處理時發生內部錯誤。請稍後重試。"
          }
        }
      }
    },
    "%@ is invalid or has expired. Enter it again in Settings and save.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 無效或已過期。請到設定重新填入後儲存。"
          }
        }
      }
    },
    "%@ is temporarily unavailable (busy or under maintenance). Try again later.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 暫時無法服務（忙碌或維護中），請稍後重試。"
          }
        }
      }
    },
    "%@ isn't allowed to use this feature, or the account or project is restricted. Check the key's permissions and the account status in the %@ console.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 沒有這項功能的權限，或帳號／專案受到限制。請到 %2$@ 後台檢查 Key 的權限與帳號狀態。"
          }
        }
      }
    },
    "%@ isn't fully downloaded or couldn't load. Download the model again in Settings.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的模型尚未下載完整或無法載入。請到設定重新下載模型。"
          }
        }
      }
    },
    "%@ meeting": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 會議"
          }
        }
      }
    },
    "%@ rejected this request. Try again; if it keeps failing, please report it.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 拒絕了這次請求的內容。請重試；若一直失敗，請回報這個問題。"
          }
        }
      }
    },
    "%@ reports that a usage or rate limit was reached. Try again later, or check your plan's quota in the %@ console.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 回報已達用量或速率上限。請稍後重試，或到 %2$@ 後台檢查方案額度。"
          }
        }
      }
    },
    "%@ returned a result in an unexpected format. Try again; if it keeps failing, please report it.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 回傳的結果格式不正確。請重試；若一直失敗，請回報這個問題。"
          }
        }
      }
    },
    "%@ signed you out. Connect it again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已登出，請重新連結。"
          }
        }
      }
    },
    "%@ · %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
        }
      }
    },
    "%@ · ^[%lld meeting](inflect: true)": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$lld 場會議"
          }
        }
      }
    },
    "%@, said ^[%lld time](inflect: true)": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，出現 %2$lld 次"
          }
        }
      }
    },
    "%lld more in your meetings": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還有 %lld 項在各場會議裡"
          }
        }
      }
    },
    "%lld open": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 項未完成"
          }
        }
      }
    },
    "API keys": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "API 金鑰"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用"
          }
        }
      }
    },
    "Action items": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "待辦事項"
          }
        }
      }
    },
    "Action items from your meetings' summaries collect here.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會議摘要裡的待辦事項會集中在這裡。"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增"
          }
        }
      }
    },
    "Add a name, product or term": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增人名、產品名稱或術語"
          }
        }
      }
    },
    "Aligning words to speakers": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對齊文字與說話者"
          }
        }
      }
    },
    "All %lld": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全部 %lld"
          }
        }
      }
    },
    "All day": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整天"
          }
        }
      }
    },
    "Allow microphone access to start recording": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請允許使用麥克風以開始錄音"
          }
        }
      }
    },
    "Allowed": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已允許"
          }
        }
      }
    },
    "Allow…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許⋯"
          }
        }
      }
    },
    "Already in your vocabulary": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已經在詞彙表裡了"
          }
        }
      }
    },
    "Already switched on? The switch may belong to an older build of mm2t. Select mm2t in the list, remove it with the − button, then add it again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已經打開了？那個開關可能屬於舊版的 mm2t。請在清單中選取 mm2t，按「−」移除後再重新加入。"
          }
        }
      }
    },
    "Apple Calendar": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 行事曆"
          }
        }
      }
    },
    "Auto-added %lld": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動新增 %lld"
          }
        }
      }
    },
    "Automation: %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動化：%@"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "返回"
          }
        }
      }
    },
    "Both audio tracks and every generated view are removed from this Mac.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩條音軌與所有產生的內容都會從這台 Mac 刪除。"
          }
        }
      }
    },
    "Bring in your calendar": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結你的行事曆"
          }
        }
      }
    },
    "By person": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依人彙整"
          }
        }
      }
    },
    "Calendars": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "行事曆"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hant": {

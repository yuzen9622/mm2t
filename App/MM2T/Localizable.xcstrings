            "value": "等待設定"
          }
        }
      }
    },
    "Waiting to process": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待處理"
          }
        }
      }
    },
    "When you save a transcript correction, mm2t automatically adds the names and terms you corrected to your vocabulary.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手動修改逐字稿並儲存後，mm2t 會自動把你修正的名稱與術語加入詞彙表。"
          }
        }
      }
    },
    "Writing the summary": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撰寫摘要"
          }
        }
      }
    },
    "Yesterday": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "昨天"
          }
        }
      }
    },
    "Your %@ account is out of credit. Top up or upgrade your plan in the %@ console, then try again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 帳號額度不足。請到 %2$@ 後台儲值或升級方案後重試。"
          }
        }
      }
    },

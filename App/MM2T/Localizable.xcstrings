            "value": "%lld 個聲紋"
          }
        }
      }
    },
    "days with meetings": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "天有開會"
          }
        }
      }
    },
    "iCloud and the accounts this Mac already syncs": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 與這台 Mac 已同步的帳號"
          }
        }
      }
    },
    "macOS isn't letting mm2t read calendars.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 不允許 mm2t 讀取行事曆。"
          }
        }
      }
    },
    "macOS permissions": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 權限"
          }
        }
      }
    },
    "mm2t": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "mm2t"
          }
        }
      }
    },
    "mm2t can't record the meeting app's audio. Allow system audio recording in System Settings.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "mm2t 無法錄製會議 App 的聲音。請在系統設定中允許系統音訊錄製。"
          }
        }
      }
    },
    "mm2t can't use Reminders. Allow it in System Settings to add to-dos there.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "mm2t 無法使用「提醒事項」。請到「系統設定」允許，才能把待辦事項加進去。"
          }
        }
      }
    },
    "mm2t can't use the microphone. Allow it in System Settings, then try again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "mm2t 無法使用麥克風。請在系統設定中允許後再試一次。"
          }
        }
      }
    },
    "mm2t could not start": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "mm2t 無法啟動"
          }
        }
      }
    },
    "mm2t is connected. You can close this tab and go back to the app.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "mm2t 已連結。你可以關閉這個分頁，回到 App。"
          }
        }
      }
    },
    "mm2t knows your voice": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "mm2t 已經認得你的聲音"
          }
        }
      }
    },
    "overlapping speech": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重疊發言"
          }
        }
      }
    },

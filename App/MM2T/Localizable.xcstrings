      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除錄音與逐字稿"
          }
        }
      }
    },
    "Delete this meeting?": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
